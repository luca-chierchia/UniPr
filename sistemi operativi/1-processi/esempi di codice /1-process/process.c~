#include <sys/types.h>
#include <sys/wait.h>
#include <stdio.h>
#include <unistd.h>

int value = 5;

int main()
{
  pid_t pid;
  pid = fork();

  if (pid == 0) { /* processo figlio */
    value += 15;
    return 0;
  }
  else if (pid > 0) { /* processo padre */
    wait(NULL);
    printf("il processo padre ha pid: %d\n", getpid());
    printf("PARENT: value = %d\n", value); /* LINEA A */
    return 0;
  }
}
